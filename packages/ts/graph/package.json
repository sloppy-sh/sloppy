{
  "name": "@sloppy/graph",
  "version": "0.0.1",
  "description": "Sloppy's graph renderer and the surface contract that drives it — see docs/ARCHITECTURE.md § \"Graph rendering\".",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./layout-worker": {
      "types": {
        "import": "./dist/layout-worker.d.mts",
        "require": "./dist/layout-worker.d.ts"
      },
      "import": "./dist/layout-worker.mjs",
      "require": "./dist/layout-worker.js",
      "default": "./dist/layout-worker.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "bench": "vite --config bench/vite.config.ts",
    "bench:build": "vite build --config bench/vite.config.ts",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false .",
    "lint": "biome ci --formatter-enabled=false --assist-enabled=false ."
  },
  "dependencies": {
    "@sloppy/types": "workspace:*",
    "d3-force": "^3.0.0",
    "graphology": "^0.26.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/d3-force": "^3.0.10",
    "graphology-types": "^0.24.8",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.11"
  }
}
