{
	"name": "@sloppy/ui",
	"version": "0.0.1",
	"description": "Sloppy's design system — the three theme axes, the graph's colour language, and the shadcn-svelte component vocabulary. See DESIGN.md.",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles": {
			"default": "./dist/app.css"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"svelte": "./dist/utils.js",
			"default": "./dist/utils.js"
		},
		"./facets": {
			"types": "./dist/components/facets/index.d.ts",
			"svelte": "./dist/components/facets/index.js",
			"default": "./dist/components/facets/index.js"
		},
		"./*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js",
			"default": "./dist/components/ui/*/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-package -o .dist-staging && node ../../../scripts/replace-dist.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"add": "shadcn-svelte add",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.561.0",
		"@sloppy/graph": "workspace:*",
		"@sloppy/types": "workspace:*",
		"@tiptap/core": "3.30.5",
		"@tiptap/extension-list": "3.30.5",
		"@tiptap/markdown": "3.30.5",
		"@tiptap/pm": "3.30.5",
		"@tiptap/starter-kit": "3.30.5",
		"@tiptap/suggestion": "3.30.5",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"jsdom": "^30.0.1",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"prettier-plugin-tailwindcss": "catalog:",
		"shadcn-svelte": "^1.1.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "^4.1.11"
	}
}
