{
  "name": "@sloppy/cli",
  "version": "0.0.1",
  "description": "Sloppy at the command line: a project's notes read, checked and written without a browser — see docs/ARCHITECTURE.md § \"Tooling\".",
  "bin": {
    "sloppy": "./dist/sloppy.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false .",
    "lint": "biome ci --formatter-enabled=false --assist-enabled=false ."
  },
  "dependencies": {
    "@sloppy/client": "workspace:*",
    "@sloppy/local": "workspace:*",
    "@sloppy/types": "workspace:*",
    "@sloppy/vault": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "^24.10.1",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
