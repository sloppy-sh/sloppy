{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // Strict env mode: a variable missing from this list never reaches a task,
  // however the shell set it — so every variable the workspace reads belongs
  // here, and hashing them is what stops a cached pass from being replayed
  // against a different database.
  "globalEnv": [
    "NODE_ENV",
    "PUBLIC_URL",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "SLOPPY_ALLOWED_ORIGINS",
    "SLOPPY_API_ORIGIN",
    "SLOPPY_API_PORT",
    "SLOPPY_IDP_SECRET",
    "SLOPPY_INTEGRATION",
    "SLOPPY_LOCAL_IDP",
    "SLOPPY_SESSION_SECRET",
    "SLOPPY_SURREALDB_URL",
    "SURREALDB_DATABASE",
    "SURREALDB_NAMESPACE",
    "SURREALDB_PASS",
    "SURREALDB_USER"
  ],
  // The other route the same values arrive by: dotenv loads the repo-root .env
  // in-process, where turbo cannot see it.
  "globalDependencies": [".env"],
  // `^build` alone is a dependency's build, not this package's own. Anything that
  // resolves a workspace import through `dist` must also wait for `build` here, or
  // `--force` runs them concurrently and the reader sees a `dist` being rewritten
  // under it — which reads as a flaky test rather than a race.
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", "dist-js/**"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^build", "build"]
    },
    "check": {
      "outputs": [],
      "dependsOn": ["^build", "build"]
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "format:check": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test:ts": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    }
  }
}
