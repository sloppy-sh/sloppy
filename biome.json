{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "apps/sloppy/api/src/**",
      "apps/sloppy/api/test/**",
      "packages/ts/types/**",
      "packages/ts/client/**",
      "packages/ts/data/**",
      "packages/ts/graph/**",
      "packages/ts/idp/**",
      "packages/ts/openpgp/**",
      "packages/ts/vault/**",
      "packages/ts/local/**",
      "packages/ts/cli/**",
      "!**/dist",
      "!**/*.d.ts",
      "!**/.svelte-kit"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "parser": { "unsafeParameterDecoratorsEnabled": true },
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noConfusingVoidType": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noUnusedPrivateClassMembers": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      }
    }
  },
  "assist": { "enabled": false }
}
