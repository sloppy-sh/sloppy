; IrohLink, the headset's link to a desk — rust/, built by rust/build.sh.
; A debug run loads the release library: there is one build of it.

[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = false

[libraries]

macos.debug.arm64 = "res://bin/libsloppy_iroh.dylib"
macos.release.arm64 = "res://bin/libsloppy_iroh.dylib"
android.debug.arm64 = "res://bin/libsloppy_iroh.so"
android.release.arm64 = "res://bin/libsloppy_iroh.so"
