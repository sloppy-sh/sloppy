; Sloppy in a headset — apps/sloppy/vr/README.md says how it is built and
; deployed; docs/ARCHITECTURE.md § "A headset beside the desk" is what it reads.

config_version=5

[application]
config/icon="res://icon.svg"

config/name="Sloppy"
config/description="The notes a desk serves, read standing in them."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]

Client="*res://client/client.gd"
Views="*res://views/views.gd"
Field="*res://field/field.gd"
Voice="*res://interaction/voice.gd"

[audio]

driver/enable_input=true

[display]

window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/sloppy_webview/plugin.cfg")

[physics]

common/physics_ticks_per_second=72

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=false
openxr/enabled.android=true
openxr/reference_space=2
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/extensions/meta/passthrough=true
openxr/extensions/meta/color_space/starting_color_space=3
shaders/enabled=true
