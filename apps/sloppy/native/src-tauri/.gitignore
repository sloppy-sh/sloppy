# Cargo output
/target/

# Generated by tauri-build from the plugins compiled in
/gen/schemas

# The Rust core compiled for iOS (libsloppy_native_lib.a, …) — hundreds of MB,
# rebuilt on every build.
/gen/apple/Externals/

# Outputs of gen/apple/project.yml, which IS tracked. scripts/patch-xcode-project.mjs
# regenerates both before every `ios` command, and the pbxproj carries a fresh
# TEMP_<uuid> group and a re-expanded ${CONFIGURATION} each time — so tracking
# them is churn on every build with no source of truth in it.
/gen/apple/*.xcodeproj/
/gen/apple/*_iOS/Info.plist
