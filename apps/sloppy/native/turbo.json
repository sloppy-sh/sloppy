{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["PUBLIC_SLOPPY_API_URL", "PUBLIC_ENABLE_LOCAL_MODE", "TAURI_ENV_PLATFORM"],
			"outputs": ["build/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
