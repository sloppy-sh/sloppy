{
  "name": "sloppy",
  "version": "0.0.1",
  "description": "Sloppy — a Zettelkasten-structured, socially-shareable knowledge graph",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "docker compose up --build --watch",
    "dev:host": "turbo dev",
    "dev:api": "pnpm --filter @sloppy/api dev",
    "dev:web": "pnpm --filter @sloppy/web dev",
    "dev:native": "pnpm build:packages && pnpm --filter @sloppy/native tauri:dev",
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/ts/*'",
    "build:packages:watch": "turbo watch build --filter='./packages/ts/*'",
    "preview": "turbo preview",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "lint": "turbo lint",
    "check": "turbo check",
    "test": "turbo test",
    "test:ts": "turbo test --filter='!@sloppy/native' && turbo test:ts --filter=@sloppy/native",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:reset": "docker compose down -v && rm -rf db/data s3/data"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "^2.9.16"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
